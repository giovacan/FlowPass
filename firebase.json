{
  "hosting": {
    "site": "passflow",
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "functions/**"],
    "rewrites": [
      { "source": "/panel/alumnos",    "destination": "/panel/alumnos/index.html" },
      { "source": "/panel/pagos",      "destination": "/panel/pagos/index.html" },
      { "source": "/panel/asistencia", "destination": "/panel/asistencia/index.html" },
      { "source": "/panel/ajustes",    "destination": "/panel/ajustes/index.html" },
      { "source": "/panel/temas",      "destination": "/panel/temas/index.html" },
      { "source": "/panel/funciones",  "destination": "/panel/funciones/index.html" },
      { "source": "/panel",            "destination": "/panel/index.html" },
      { "source": "/onboarding",       "destination": "/onboarding/index.html" },
      { "source": "/login",            "destination": "/login/index.html" },
      { "source": "/suspendido",       "destination": "/suspendido/index.html" },
      { "source": "/",                 "destination": "/index.html" },
      { "source": "/**",               "destination": "/_/index.html" }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
